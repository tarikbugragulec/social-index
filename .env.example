# ==========================================================================
# SOCIAL INDEX — Environment Variables Template (.env.example)
# Copy this file to `.env` and fill in your optional official API keys.
# All keys are optional; the app works out-of-the-box without keys as well.
# ==========================================================================

PORT=3000

# 1. Meta for Developers (https://developers.facebook.com/tools/explorer/)
META_ACCESS_TOKEN=
IG_BUSINESS_USER_ID=
THREADS_ACCESS_TOKEN=
META_APP_TOKEN=

# 2. Google Cloud — YouTube Data API v3
YOUTUBE_API_KEY=

# 3. X (Twitter) Developer Portal — API v2 Bearer Token
X_BEARER_TOKEN=

# 4. TikTok for Developers — Research / Display API v2
TIKTOK_ACCESS_TOKEN=

# 5. GitHub REST API — Personal Access Token (Optional, increases rate limit to 5000/hr)
GITHUB_TOKEN=

